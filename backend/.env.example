# Use a distinct DB name per environment (e.g. "_dev" locally) so it's obvious
# in Compass/mongosh which database you're connected to — prod uses
# "digital_ai_project" (see k8s/base/secret.example.yaml in the pulsedev-infra repo).
MONGO_URI=mongodb://<user>:<password>@localhost:27017/digital_ai_project_dev?authSource=admin

# RSS feed URLs to collect. Falls back to a built-in default list if unset/invalid.
# Accepts a flat JSON array of URLs, an array of { name, url }, or a categorized
# object of those (e.g. { "nodejs": [{ "name": "Node Weekly", "url": "..." }], ... }).
RSS_FEEDS=["https://news.ycombinator.com/rss","https://www.reddit.com/r/programming/.rss","https://nodeweekly.com/rss"]

# Cron expression for how often RSS_FEEDS are collected. Default: every hour.
RSS_CRON_SCHEDULE=0 * * * *

# How many articles RssCollectorServices extracts in parallel per source. Default: 3.
RSS_FETCH_CONCURRENCY=3

LOG_LEVEL=info

# HTTP server port. Default: 3000.
PORT=3000

# Default page size for GET /feed/items when ?limit is omitted. Default: 20.
DEFAULT_ITEMS_LIMIT=20

# Number of feeds returned by GET /feed/list. Default: 5.
FEEDS_PAGE_SIZE=5

MONGO_INITDB_ROOT_USERNAME=<user>
MONGO_INITDB_ROOT_PASSWORD=<password>

# Toggles the in-process node-cron scheduler (SchedulerService.start()). Default: true.
# Set to false in Kubernetes, where scheduling is handled by a separate CronJob instead.
ENABLE_IN_PROCESS_SCHEDULER=true

# Toggles Swagger UI at /docs. Default: true. Set to false in Kubernetes — it's
# for local testing only. Can't gate this on NODE_ENV: the Dockerfile hardcodes
# NODE_ENV=production for both docker-compose and Kubernetes (needed for
# `npm ci --omit=dev`), so it can't tell the two apart.
ENABLE_SWAGGER=true

# Standard Express/Node environment flag. development when run directly via
# `npm run dev`/dev.sh — the Dockerfile hardcodes this to production for both
# docker-compose and Kubernetes, so it does NOT mean "not local" by itself.
NODE_ENV=development
# Telegram bot token from @BotFather. When unset, TelegramBotService.start()
# is a no-op — the bot simply doesn't start (no error). Never commit a real
# value here; set it only in your local .env / the cluster secret.
TELEGRAM_BOT_TOKEN=

# Cron schedule for the Telegram channel collector (TelegramSchedulerService).
# Independent of RSS_CRON_SCHEDULE — t.me/s/<username> is an unofficial page,
# so this doesn't have to match RSS's cadence. Default: every 30 minutes.
TELEGRAM_CRON_SCHEDULE=*/30 * * * *

# How many of a channel's most-recent posts TelegramCollectorService considers
# per collect() run. Default: 5.
TELEGRAM_POSTS_PER_CHANNEL_LIMIT=5
