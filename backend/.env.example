# Use a distinct DB name per environment (e.g. "_dev" locally) so it's obvious
# in Compass/mongosh which database you're connected to — prod uses
# "digital_ai_project" (see infra/k8s/base/secret.example.yaml).
MONGO_URI=mongodb://<user>:<password>@localhost:27017/digital_ai_project_dev?authSource=admin

# RSS feed URLs to collect. Falls back to a built-in default list if unset/invalid.
# Accepts a flat JSON array of URLs, an array of { name, url }, or a categorized
# object of those (e.g. { "nodejs": [{ "name": "Node Weekly", "url": "..." }], ... }).
RSS_FEEDS=["https://news.ycombinator.com/rss","https://www.reddit.com/r/programming/.rss","https://nodeweekly.com/rss"]

# Cron expression for how often RSS_FEEDS are collected. Default: every hour.
RSS_CRON_SCHEDULE=0 * * * *

# How many articles RssCollectorServices extracts in parallel per source. Default: 3.
RSS_FETCH_CONCURRENCY=3

# HTTP server port. Default: 3000.
PORT=3000

# Default page size for GET /feed/items when ?limit is omitted. Default: 20.
DEFAULT_ITEMS_LIMIT=20

# Number of feeds returned by GET /feed/list. Default: 5.
FEEDS_PAGE_SIZE=5

MONGO_INITDB_ROOT_USERNAME=<user>
MONGO_INITDB_ROOT_PASSWORD=<password>

# Toggles the in-process node-cron scheduler (SchedulerService.start()). Default: true.
# Set to false in Kubernetes, where scheduling is handled by a separate CronJob instead.
ENABLE_IN_PROCESS_SCHEDULER=true

# Standard Express/Node environment flag. development locally, production in Kubernetes.
NODE_ENV=development