{
    "name": "digest-plans-project",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
        "start": "node dist/index.js",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "lint": "eslint .",
        "test": "vitest run",
        "extract": "tsx bin/extract.ts"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "awilix": "^13.0.5",
        "axios": "^1.18.1",
        "cheerio": "^1.2.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "iconv-lite": "^0.7.3",
        "jsdom": "^30.0.0",
        "mongoose": "^9.7.4",
        "node-cron": "^4.6.0",
        "node-fetch": "^3.3.2",
        "p-limit": "^7.3.1",
        "rss-parser": "^3.13.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.3",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.5",
        "supertest": "^7.2.2",
        "tsx": "^4.20.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
