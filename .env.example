# Used only by docker-compose.yml, to set up the mongo service and to build
# backend's MONGO_URI for the compose network. Copy to .env (gitignored) and fill in.
MONGO_INITDB_ROOT_USERNAME=digestAdmin
MONGO_INITDB_ROOT_PASSWORD=<password>

# Name of the local dev database inside the compose "mongo" service. Defaults
# to digital_ai_project_dev if unset. Keep this different from the prod
# database name (see k8s/base/secret.example.yaml in the pulsedev-infra repo)
# so it's obvious which environment you're looking at in Compass/mongosh.
MONGO_DB_NAME=digital_ai_project_dev
